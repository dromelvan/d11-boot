meta {
  name: GET matches/{matchId}/player-match-stats?teamId={teamId} - 200
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v2/matches/{{matchId}}/player-match-stats?teamId={{matchPlayerMatchStatsTeamId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.playerMatchStats: isDefined
  res.body.playerMatchStats.length: eq 1
}

tests {
  const { expectToEq } = require('./d11.js');

  test("GET match team player match stats response body", () => {
    const body = res.getBody();
    const playerMatchStats = JSON.parse(bru.getEnvVar("matchTeamPlayerMatchStats"));

    for (let i = 0; i < playerMatchStats.length; ++i) {
      expectToEq.playerMatchStat(body.playerMatchStats[i], playerMatchStats[i]);
    }

  });

}
