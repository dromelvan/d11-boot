meta {
  name: GET d11-matches/{d11MatchId}/player-match-stats?d11TeamId={d11TeamId} - 200
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v2/d11-matches/{{d11MatchId}}/player-match-stats?d11TeamId={{d11MatchPlayerMatchStatsD11TeamId}}
  body: none
  auth: none
}

assert {
  res.status: eq 200
  res.body.playerMatchStats: isDefined
  res.body.playerMatchStats.length: eq 1
}

tests {
  const { expectToEq } = require('./d11.js');

  test("GET D11 match team player match stats response body", () => {
    const body = res.getBody();
    const playerMatchStats = JSON.parse(bru.getEnvVar("d11MatchTeamPlayerMatchStats"));

    for (let i = 0; i < playerMatchStats.length; ++i) {
      expectToEq.playerMatchStat(body.playerMatchStats[i], playerMatchStats[i]);
    }

  });

}
